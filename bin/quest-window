#!/usr/bin/env bash
# quest-window: open the terminal window for a project, or for one of its quests,
# or focus that window when it is already open. A project is a realm of the
# quest command, which finds it in a world: a directory of realms on a host, or
# on this computer. Each window attaches to a shpool session there, through
# quest-session; sessionctl, run there too, chooses the sessions. With -l, list
# the worlds, projects, and quests, as the quest command does. The Questmarchy
# bar widget runs it from the plugin folder; see README.md there.
set -euo pipefail

world=
dry_run=
# When each project's or quest's window was last opened or focused, as
# [{place, project, slug, opened}], with no slug for a project. place is the
# world, under the name it had before the quest command. The bar widget lists
# the most recently opened first.
opened_file=${XDG_STATE_HOME:-$HOME/.local/state}/questmarchy/opened.json

usage() {
  cat <<EOF
Usage: quest-window [-n] [-w <world>] <project> [<slug>]
       quest-window -l

Open the window for a project's root, or for its quest <slug>.

A world is a directory of projects on a host, or on this computer, as
\`quest world list\` prints it. Without -w, the project is looked for in all
of them.

  -w  the world of the project
  -n  print what would be done instead of doing it
  -l  print the worlds, projects, and quests as JSON
EOF
}

notice() {
  echo "quest-window: $*" >&2
  # Run from a key binding there is no terminal to print to.
  [[ -t 2 ]] || notify-send "quest-window" "$*" 2>/dev/null || true
}

fail() {
  notice "$@"
  exit 1
}

# Run sessionctl with the remaining arguments in the home directory on the
# host, or here when it is empty, from a login shell, whose profile puts
# python3, shpool, and the agent on PATH wherever they are installed. Here it is
# the plugin's own. On a host it is the copy that quest-session runs there too,
# and the plugin's goes along on standard input, in the same ssh call, to
# replace it first when it is missing or differs. Forwardings are cleared so the
# host's configured tunnels are not opened.
run_sessionctl() {
  local host=$1
  shift
  if [[ -z $host ]]; then
    (cd && bash -lc 'exec "$0" "$@"' "$here/sessionctl" "$@")
  else
    ssh -o BatchMode=yes -o ConnectTimeout=10 -o ClearAllForwardings=yes "$host" \
      bash -lc "'$install_sessionctl'" sessionctl "${@@Q}" <"$here/sessionctl"
  fi
}

# Put sessionctl from standard input in ~/.local/share/questmarchy/bin, unless
# the same is there, then run it with the arguments. It is replaced whole, so
# that a window attaching meanwhile never runs part of it. Without cmp, it is
# replaced every time. The script holds no single quote, so that in single
# quotes it reaches the host's shell as it is, where ${...@Q} would put its
# newlines in $'...', which not every shell reads.
install_sessionctl='
set -e
bin=$HOME/.local/share/questmarchy/bin
mkdir -p "$bin"
tmp=$(mktemp "$bin/.sessionctl.XXXXXX")
cat >"$tmp"
if cmp -s "$tmp" "$bin/sessionctl"; then
  rm -f "$tmp"
else
  chmod +x "$tmp"
  mv -f "$tmp" "$bin/sessionctl"
fi
exec "$bin/sessionctl" "$@"
'

# The quest command: on PATH, or where the quest skill installs it.
find_quest() {
  local skill
  if command -v quest >/dev/null; then
    quest=(quest)
    return
  fi
  for skill in "$HOME/.claude/skills/quest" "$HOME/.agents/skills/quest"; do
    if [[ -f $skill/bin/quest ]]; then
      quest=(python3 "$skill/bin/quest")
      return
    fi
  done
  fail "the quest command is not installed: neither on PATH nor in the quest skill"
}

# Print {worlds: [{world, host, path}], projects: [{world, name}], quests:
# [{world, project, slug}], failed: [<world>]}, from the quest command's
# lists, leaving out unsafe names. failed holds the worlds that could not be
# listed; a realm that could not be listed is left out.
list_all() {
  local listed status=0 pid
  local -a pids=()
  listed=$(mktemp -d)
  "${quest[@]}" world list >"$listed/worlds" & pids+=("$!")
  "${quest[@]}" realm list >"$listed/realms" & pids+=("$!")
  "${quest[@]}" list >"$listed/quests" & pids+=("$!")
  for pid in "${pids[@]}"; do
    wait "$pid" || status=1
  done
  (( status == 0 )) && jq -n "$names_jq"'
    input as $worlds | input as $realms | input as $quests
    | {
        worlds: [$worlds[] | {world, host, path}],
        projects: [$realms.realms[] | select(.realm | project) | {world, name: .realm}],
        quests: [$quests.quests[] | select((.realm | project) and (.slug | slug))
          | {world, project: .realm, slug}],
        failed: [$realms.failed[], $quests.failed[] | select(has("realm") | not) | .world] | unique
      }' "$listed/worlds" "$listed/realms" "$listed/quests" || status=1
  rm -rf "$listed"
  return "$status"
}

# Record that the window for the project or quest was opened now, in place of
# its last time. A missing or unreadable record starts over. The file is
# replaced whole, so the widget never reads a partial one.
record_opened() {
  local dir=${opened_file%/*} tmp
  mkdir -p "$dir" && tmp=$(mktemp "$dir/.opened.XXXXXX") || return
  { cat "$opened_file" 2>/dev/null || true; } | jq -Rs \
    --arg place "$world" --arg project "$project" --arg slug "$slug" --argjson now "$(date +%s)" '
    (try fromjson catch null) as $record
    | [($record | if type == "array" then .[] else empty end)
        | select(.place != $place or .project != $project or (.slug // "") != $slug)]
      + [{place: $place, project: $project} + (if $slug == "" then {} else {slug: $slug} end) + {opened: $now}]' \
    >"$tmp" && mv -f "$tmp" "$opened_file" || { rm -f "$tmp"; return 1; }
}

# Names that could not be passed safely to the shell running an action.
names_jq='
  def project: test("^[A-Za-z0-9._-]+$");
  def slug: test("^[a-z0-9]+(-[a-z0-9]+)*$");
'

list=
while getopts nlw:h opt; do
  case $opt in
    n) dry_run=1 ;;
    l) list=1 ;;
    w) world=$OPTARG ;;
    h) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done
shift $((OPTIND - 1))

find_quest

if [[ -n $list ]]; then
  (( $# == 0 )) || { usage >&2; exit 2; }
  # The caller reports the worlds that failed: the bar widget shows them in
  # its panel.
  list_all
  exit
fi

if (( $# < 1 || $# > 2 )); then
  usage >&2
  exit 2
fi

project=$1
slug=${2:-}

[[ $project =~ ^[A-Za-z0-9._-]+$ ]] || fail "not a project name: $project"
[[ -z $slug || $slug =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || fail "not a quest slug: $slug"

# Print the project or quest as quest realm show or quest show does. With no
# world, it is looked for in every world.
find_entry() {
  local errors output status=0
  errors=$(mktemp)
  if [[ -n $slug ]]; then
    output=$("${quest[@]}" show ${world:+--world="$world"} -- "$project" "$slug" 2>"$errors") || status=$?
  else
    output=$("${quest[@]}" realm show ${world:+--world="$world"} -- "$project" 2>"$errors") || status=$?
  fi
  local message=$(<"$errors")
  rm -f "$errors"
  (( status == 0 )) || fail "${message:-quest exited with status $status}"
  printf '%s\n' "$output"
}

entry=
if [[ -z $world ]]; then
  entry=$(find_entry)
  world=$(jq -r .world <<<"$entry")
fi
# The quest command lists the worlds from a file here, so that focusing an open
# window reaches no host. host is empty for this computer, and is checked since
# it goes into ssh's arguments and the window's class.
worlds=$("${quest[@]}" world list) || fail "could not list the worlds"
host=$(jq -re --arg world "$world" 'first(.[] | select(.world == $world)) | .host // ""' <<<"$worlds") ||
  fail "not a world in quest world list: $world"
[[ -z $host || $host =~ ^[A-Za-z0-9._-]+$ ]] || fail "not a host name: $host"

machine=${host:-$(uname -n)}
prefix=questmarchy:$project${slug:+:$slug}
# Omarchy tags TUI.* windows as terminals, so Super+V pastes in them. Without
# the tag it sends Ctrl+V, which an agent such as Claude Code takes as an image
# paste, dropping text.
class=TUI.questmarchy.$machine.$project${slug:+.$slug}
# A new session starts Omarchy's default agent on this computer, as its own
# command wherever the project lives.
agent=$(omarchy-default-agent 2>/dev/null || true)
[[ $agent =~ ^[a-z][a-z0-9-]*$ ]] || agent=
here=$(dirname "$(realpath "${BASH_SOURCE[0]}")")

address=$(hyprctl clients -j | jq -r --arg class "$class" '.[] | select(.class == $class) | .address' | head -n1)

# Run in a window: attach to a session that sessionctl chose. The
# launcher runs it with xdg-terminal-exec -e, which still reads options such as
# -h in the command, so quest-session takes none.
window_command() {
  command=(omarchy-launch-tui --app-id="$class" bash "$here/quest-session" "${host:-localhost}" "$1" "$2" ${3:+"$3"})
}

if [[ -n $address ]]; then
  command=(hyprctl dispatch "hl.dsp.focus({ window = \"address:$address\" })")
  if [[ -n $dry_run ]]; then
    echo "would run: ${command[*]}"
  else
    "${command[@]}" >/dev/null
    record_opened || true
  fi
  exit
fi

# Only a session that is created needs the directory, which the quest command
# finds in the realm's quests directory.
[[ -n $entry ]] || entry=$(find_entry)
dir=$(jq -r .dir <<<"$entry")

if [[ -n $dry_run ]]; then
  echo "would attach every disconnected $prefix:<number> on $machine and recreate every linked one shpool lost, or else create one in $dir with ${agent:-no agent}"
  window_command "$prefix:<number>" "$dir" "$agent"
  echo "would run for each: ${command[*]}"
else
  output=$(run_sessionctl "$host" prepare "$prefix:" "$dir" "$agent" 2>&1) ||
    fail "could not open a session for $prefix on $machine: $output"
  # sessionctl answers on the last line, after anything the login shell's
  # profile printed.
  answer() { jq -r "$1" <<<"${output##*$'\n'}"; }
  mapfile -t sessions < <(answer '.sessions[]' 2>/dev/null)
  (( ${#sessions[@]} > 0 )) || fail "could not read the sessions on $machine: $output"
  mapfile -t notices < <(answer '.notices[]')
  for message in "${notices[@]}"; do
    notice "$message"
  done
  record_opened || true
  dir=$(answer .dir) agent=$(answer .agent)
  for session in "${sessions[@]}"; do
    window_command "$session" "$dir" "$agent"
    "${command[@]}" || notice "could not open a window for $session"
  done
fi
