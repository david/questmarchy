#!/usr/bin/env bash
# quest-window: open the terminal window for a project, or for one of its quests,
# or focus that window when it is already open. A project lives in a place: a
# directory of projects on a host, or on this computer. Each window attaches to
# a shpool session there, through quest-session. With -l, list the projects and
# quests in some places. The Questmarchy bar widget runs it from the plugin folder; see
# README.md there.
set -euo pipefail

default_place='~/Projects'
place=$default_place
dry_run=
# When each project's or quest's window was last opened or focused, as
# [{place, project, slug, opened}], with no slug for a project. The bar widget
# lists the most recently opened first.
opened_file=${XDG_STATE_HOME:-$HOME/.local/state}/questmarchy/opened.json

usage() {
  cat <<EOF
Usage: quest-window [-n] [-p <place>] <project> [<slug>]
       quest-window -l [<place>...]

Open the window for a project's root, or for its quest <slug>.

A place is [<host>:]<path>, a directory of projects on <host>, or on this
computer when there is no host or <host> is this computer's name. A relative
<path> starts at the home directory. The default is $default_place.

  -p  the place of the project
  -n  print what would be done instead of doing it
  -l  print the projects and quests in the places as JSON, most recently
      active first
EOF
}

notice() {
  echo "quest-window: $*" >&2
  # Run from a key binding there is no terminal to print to.
  [[ -t 2 ]] || notify-send "quest-window" "$*" 2>/dev/null || true
}

fail() {
  notice "$@"
  exit 1
}

# Set host and path from a place, leaving host empty for this computer. Fails
# for a place that could not be passed safely to the shell running an action.
parse_place() {
  if [[ $1 =~ ^([^:/]+):(.*)$ ]]; then
    host=${BASH_REMATCH[1]} path=${BASH_REMATCH[2]}
  else
    host= path=$1
  fi
  [[ ${host%%.*} == "$(uname -n | cut -d. -f1)" || $host == localhost ]] && host=
  [[ -z $host || $host =~ ^[A-Za-z0-9._-]+$ ]] && [[ -n $path && $path != *[$'\t\n']* ]]
}

# Run bash in the home directory on the host, or here when it is empty, with
# the script on standard input. The remaining arguments go to bash: its
# options, then -s -- and the script's arguments. Forwardings are cleared so
# the host's configured tunnels are not opened.
on_host() {
  local host=$1
  shift
  if [[ -z $host ]]; then
    (cd && bash "$@")
  else
    ssh -o BatchMode=yes -o ConnectTimeout=10 -o ClearAllForwardings=yes "$host" bash "${@@Q}"
  fi
}

# Print "<project><TAB><TAB><time>" for each project in the place with a
# quests directory, followed by "<project><TAB><slug><TAB><time>" for each of
# its active quests. <time> is when the project root or the quest was last
# active, in seconds since the epoch: the newest change to a Claude Code
# transcript started there or, for a quest, to its records.
list_place() {
  on_host "$1" -s -- "$2" <<'EOF'
shopt -s nullglob
path=$1
case $path in "~") path=$HOME ;; "~/"*) path=$HOME/${path#"~/"} ;; esac
cd -- "$path" || exit
# Claude Code keeps the transcripts of a directory under its physical path,
# with every character other than a letter or digit replaced by a hyphen.
root=$(pwd -P)
transcript_times() {
  local dir=$root/$1
  find "$HOME/.claude/projects/${dir//[^A-Za-z0-9]/-}" -maxdepth 1 -name '*.jsonl' -printf '%T@\n'
}
newest() { sort -rn | head -n1 | cut -d. -f1; }
for quests in */quests/; do
  project=${quests%%/*}
  time=$(transcript_times "$project" 2>/dev/null | newest)
  printf '%s\t\t%s\n' "$project" "$time"
  for record in "$quests"*/QUEST.md; do
    quest=${record%/QUEST.md}
    time=$({
      find "$quest" -mindepth 1 \( -name .git -o -name worktrees -o -name local-data \) -prune \
        -o -type f -printf '%T@\n'
      transcript_times "$quest"
    } 2>/dev/null | newest)
    printf '%s\t%s\t%s\n' "$project" "${quest##*/}" "$time"
  done
done
EOF
}

# List all the places at once. Print each line that list_place prints for a
# place after "<place><TAB>", and the place alone when it could not be listed.
list_places() {
  local listed i line
  local -a pids=()
  listed=$(mktemp -d)
  for i in "${!places[@]}"; do
    { parse_place "${places[i]}" && list_place "$host" "$path"; } >"$listed/$i" 2>/dev/null &
    pids+=("$!")
  done
  for i in "${!places[@]}"; do
    if wait "${pids[i]}"; then
      while IFS= read -r line; do
        printf '%s\t%s\n' "${places[i]}" "$line"
      done <"$listed/$i"
    else
      printf '%s\n' "${places[i]}"
    fi
  done
  rm -rf "$listed"
}

# Record that the window for the project or quest was opened now, in place of
# its last time. A missing or unreadable record starts over. The file is
# replaced whole, so the widget never reads a partial one.
record_opened() {
  local dir=${opened_file%/*} tmp
  mkdir -p "$dir" && tmp=$(mktemp "$dir/.opened.XXXXXX") || return
  { cat "$opened_file" 2>/dev/null || true; } | jq -Rs \
    --arg place "$place" --arg project "$project" --arg slug "$slug" --argjson now "$(date +%s)" '
    (try fromjson catch null) as $record
    | [($record | if type == "array" then .[] else empty end)
        | select(.place != $place or .project != $project or (.slug // "") != $slug)]
      + [{place: $place, project: $project} + (if $slug == "" then {} else {slug: $slug} end) + {opened: $now}]' \
    >"$tmp" && mv -f "$tmp" "$opened_file" || { rm -f "$tmp"; return 1; }
}

# Names that could not be passed safely to the shell running an action.
names_jq='
  def project: test("^[A-Za-z0-9._-]+$");
  def slug: test("^[a-z0-9]+(-[a-z0-9]+)*$");
'

# Get ready to open a session on the host in the given directory. Print "dir:
# <dir>" with the directory's full path; "agent: <agent>" with the agent to
# start, empty when it is not installed or there is no default, and then
# "reason: <text>" saying why; and, after a line "sessions:", the host's
# sessions as shpool list --json prints them. The shell is a login shell, whose
# profile puts shpool and the agent on PATH wherever they are installed.
prepare_session() {
  on_host "$1" -l -s -- "$2" "$3" <<'EOF'
set -eu
dir=$1 agent=$2
case $dir in "~") dir=$HOME ;; "~/"*) dir=$HOME/${dir#"~/"} ;; esac
command -v shpool >/dev/null || { echo "shpool is not on PATH on $(uname -n)" >&2; exit 1; }
[ -d "$dir" ] || { echo "no directory $dir" >&2; exit 1; }
cd "$dir"
echo "dir: $PWD"
if [ -z "$agent" ]; then
  echo "reason: no default agent is chosen (omarchy default agent <name>)"
elif ! command -v "$agent" >/dev/null; then
  echo "reason: $agent is not installed on $(uname -n)"
  agent=
fi
echo "agent: $agent"
echo "sessions:"
shpool list --json
EOF
}

# From shpool list --json, choose the session named <prefix>:<number> for a
# window: the disconnected one with the lowest number, so a closed window's
# agent is picked up again, or else a new one with the lowest free number.
# Print "<number> existing" or "<number> new".
choose_session_jq='
  [.sessions[] | select(.name | startswith($prefix))
    | {number: (.name | ltrimstr($prefix)), status: (.status | ascii_downcase)}
    | select(.number | test("^[1-9][0-9]*$")) | .number |= tonumber]
  | (map(select(.status == "disconnected")) | min_by(.number) | .number) as $detached
  | if $detached then "\($detached) existing"
    else "\([range(1; length + 2)] - map(.number) | min) new" end
'

# Turn the list into {projects: [{place, name, updated}], quests: [{place,
# project, slug, updated}], failed: [place]}, the first two most recently
# active first, leaving out unsafe names. A project was last active when its
# root or any of its quests was. failed holds the places that could not be
# listed.
list_json() {
  jq -R -s "$names_jq"'
    [split("\n")[] | select(. != "") | split("\t")]
    | [.[] | select(length == 1) | .[0]] as $failed
    | [.[] | select(length > 1)
        | {place: .[0], project: .[1], slug: (.[2] // ""), updated: ((.[3] // "") | tonumber? // 0)}
        | select((.project | project) and (.slug == "" or (.slug | slug)))]
    | map(select(.slug != "")) as $quests
    | {
        projects: [.[] | select(.slug == "") | . as $root
          | {place, name: .project,
             updated: ([.updated, ($quests[] | select(.place == $root.place and .project == $root.project) | .updated)] | max)}]
          | sort_by(-.updated, .name, .place),
        quests: $quests | sort_by(-.updated, .project, .slug, .place),
        failed: $failed
      }'
}

list=
while getopts nlp:h opt; do
  case $opt in
    n) dry_run=1 ;;
    l) list=1 ;;
    p) place=$OPTARG ;;
    h) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done
shift $((OPTIND - 1))

if [[ -n $list ]]; then
  places=("$@")
  (( ${#places[@]} > 0 )) || places=("$default_place")
  # The caller reports the places that failed: the bar widget shows them in
  # its panel.
  list_places | list_json
  exit
fi

if (( $# < 1 || $# > 2 )); then
  usage >&2
  exit 2
fi

project=$1
slug=${2:-}

parse_place "$place" || fail "not a place: $place"
[[ $project =~ ^[A-Za-z0-9._-]+$ ]] || fail "not a project name: $project"
[[ -z $slug || $slug =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || fail "not a quest slug: $slug"

machine=${host:-$(uname -n)}
prefix=questmarchy:$project${slug:+:$slug}
# Omarchy tags TUI.* windows as terminals, so Super+V pastes in them. Without
# the tag it sends Ctrl+V, which an agent such as Claude Code takes as an image
# paste, dropping text.
class=TUI.questmarchy.$machine.$project${slug:+.$slug}
dir=${path%/}/$project${slug:+/quests/$slug}
# A new session starts Omarchy's default agent on this computer, as its own
# command wherever the project lives.
agent=$(omarchy-default-agent 2>/dev/null || true)
[[ $agent =~ ^[a-z][a-z0-9-]*$ ]] || agent=
here=$(dirname "$(realpath "${BASH_SOURCE[0]}")")

address=$(hyprctl clients -j | jq -r --arg class "$class" '.[] | select(.class == $class) | .address' | head -n1)

# Run in the window: attach to the session that prepare_session chose. The
# launcher runs it with xdg-terminal-exec -e, which still reads options such as
# -h in the command, so quest-session takes none.
window_command() {
  command=(omarchy-launch-tui --app-id="$class" bash "$here/quest-session" "${host:-localhost}" "$1" "$2" ${3:+"$3"})
}

if [[ -n $address ]]; then
  command=(hyprctl dispatch "hl.dsp.focus({ window = \"address:$address\" })")
  if [[ -n $dry_run ]]; then
    echo "would run: ${command[*]}"
  else
    "${command[@]}" >/dev/null
    record_opened || true
  fi
elif [[ -n $dry_run ]]; then
  echo "would attach the first disconnected $prefix:<number> on $machine, or create one in $dir with ${agent:-no agent}"
  window_command "$prefix:<number>" "$dir" "$agent"
  echo "would run: ${command[*]}"
else
  output=$(prepare_session "$host" "$dir" "$agent" 2>&1) ||
    fail "could not open a session for $prefix on $machine: $output"
  field() { sed -n "s/^$1: //p" <<<"$output"; }
  chosen=$(sed '1,/^sessions:$/d' <<<"$output" | jq -r --arg prefix "$prefix:" "$choose_session_jq" 2>/dev/null) ||
    fail "could not read the sessions on $machine: $output"
  # A running session ignores the agent and keeps its own. A session whose agent
  # exited while no window was attached is still listed, and starts it again.
  reason=$(field reason)
  [[ $chosen != *new || -z $reason ]] || notice "the session starts a shell, because $reason"
  window_command "$prefix:${chosen% *}" "$(field dir)" "$(field agent)"
  record_opened || true
  exec "${command[@]}"
fi
