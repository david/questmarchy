#!/usr/bin/env bash
# quest-window: open the terminal window for a project, or for one of its quests,
# or focus that window when it is already open. A project is a realm of the
# quest command, which finds it in a world: a directory of realms on a host, or
# on this computer. Each window attaches to a shpool session there, through
# quest-session. With -l, list the worlds, projects, and quests, as the quest
# command does. The Questmarchy bar widget runs it from the plugin folder; see
# README.md there.
set -euo pipefail

world=
dry_run=
# When each project's or quest's window was last opened or focused, as
# [{place, project, slug, opened}], with no slug for a project. place is the
# world, under the name it had before the quest command. The bar widget lists
# the most recently opened first.
opened_file=${XDG_STATE_HOME:-$HOME/.local/state}/questmarchy/opened.json

usage() {
  cat <<EOF
Usage: quest-window [-n] [-w <world>] <project> [<slug>]
       quest-window -l

Open the window for a project's root, or for its quest <slug>.

A world is [<host>:]<path>, a directory of projects on <host>, or on this
computer when there is no host or <host> is this computer's name;
\`quest world list\` prints yours. Without -w, the project is looked for in
all of them.

  -w  the world of the project
  -n  print what would be done instead of doing it
  -l  print the worlds, projects, and quests as JSON
EOF
}

notice() {
  echo "quest-window: $*" >&2
  # Run from a key binding there is no terminal to print to.
  [[ -t 2 ]] || notify-send "quest-window" "$*" 2>/dev/null || true
}

fail() {
  notice "$@"
  exit 1
}

# Set host and path from a world, leaving host empty for this computer. Fails
# for a world that could not be passed safely to the shell running an action.
parse_world() {
  if [[ $1 =~ ^([^:/]+):(.*)$ ]]; then
    host=${BASH_REMATCH[1]} path=${BASH_REMATCH[2]}
  else
    host= path=$1
  fi
  [[ ${host%%.*} == "$(uname -n | cut -d. -f1)" || $host == localhost ]] && host=
  [[ -z $host || $host =~ ^[A-Za-z0-9._-]+$ ]] && [[ -n $path && $path != *[$'\t\n']* ]]
}

# Run bash in the home directory on the host, or here when it is empty, with
# the script on standard input. The remaining arguments go to bash: its
# options, then -s -- and the script's arguments. Forwardings are cleared so
# the host's configured tunnels are not opened.
on_host() {
  local host=$1
  shift
  if [[ -z $host ]]; then
    (cd && bash "$@")
  else
    ssh -o BatchMode=yes -o ConnectTimeout=10 -o ClearAllForwardings=yes "$host" bash "${@@Q}"
  fi
}

# The quest command: on PATH, or where the quest skill installs it.
find_quest() {
  local skill
  if command -v quest >/dev/null; then
    quest=(quest)
    return
  fi
  for skill in "$HOME/.claude/skills/quest" "$HOME/.agents/skills/quest"; do
    if [[ -f $skill/bin/quest ]]; then
      quest=(python3 "$skill/bin/quest")
      return
    fi
  done
  fail "the quest command is not installed: neither on PATH nor in the quest skill"
}

# Print {worlds: [{world, host, path}], projects: [{world, name}], quests:
# [{world, project, slug}], failed: [<world>]}, from the quest command's
# lists, leaving out unsafe names. failed holds the worlds that could not be
# listed; a realm that could not be listed is left out.
list_all() {
  local listed status=0 pid
  local -a pids=()
  listed=$(mktemp -d)
  "${quest[@]}" world list >"$listed/worlds" & pids+=("$!")
  "${quest[@]}" realm list >"$listed/realms" & pids+=("$!")
  "${quest[@]}" list >"$listed/quests" & pids+=("$!")
  for pid in "${pids[@]}"; do
    wait "$pid" || status=1
  done
  (( status == 0 )) && jq -n "$names_jq"'
    input as $worlds | input as $realms | input as $quests
    | {
        worlds: [$worlds[] | {world, host, path}],
        projects: [$realms.realms[] | select(.realm | project) | {world, name: .realm}],
        quests: [$quests.quests[] | select((.realm | project) and (.slug | slug))
          | {world, project: .realm, slug}],
        failed: [$realms.failed[], $quests.failed[] | select(has("realm") | not) | .world] | unique
      }' "$listed/worlds" "$listed/realms" "$listed/quests" || status=1
  rm -rf "$listed"
  return "$status"
}

# Record that the window for the project or quest was opened now, in place of
# its last time. A missing or unreadable record starts over. The file is
# replaced whole, so the widget never reads a partial one.
record_opened() {
  local dir=${opened_file%/*} tmp
  mkdir -p "$dir" && tmp=$(mktemp "$dir/.opened.XXXXXX") || return
  { cat "$opened_file" 2>/dev/null || true; } | jq -Rs \
    --arg place "$world" --arg project "$project" --arg slug "$slug" --argjson now "$(date +%s)" '
    (try fromjson catch null) as $record
    | [($record | if type == "array" then .[] else empty end)
        | select(.place != $place or .project != $project or (.slug // "") != $slug)]
      + [{place: $place, project: $project} + (if $slug == "" then {} else {slug: $slug} end) + {opened: $now}]' \
    >"$tmp" && mv -f "$tmp" "$opened_file" || { rm -f "$tmp"; return 1; }
}

# Names that could not be passed safely to the shell running an action.
names_jq='
  def project: test("^[A-Za-z0-9._-]+$");
  def slug: test("^[a-z0-9]+(-[a-z0-9]+)*$");
'

# Get ready to open the sessions named <prefix><number> on the host, in the
# given directory. Print "dir: <dir>" with the directory's full path; "agent:
# <agent>" with the agent to start, empty when it is not installed or there is
# no default, and then "reason: <text>" saying why; "unlinked: <text>" when the
# agent is Claude and Questmarchy's plugin for it, whose hooks link sessions to
# conversations, is not installed; "link: <session>" for each session that is
# linked to a conversation, from the files those hooks keep; and, after a line
# "sessions:", the host's sessions as shpool list --json prints them. The shell
# is a login shell, whose profile puts shpool and the agent on PATH wherever
# they are installed.
prepare_session() {
  on_host "$1" -l -s -- "$2" "$3" "$4" <<'EOF'
set -eu
dir=$1 agent=$2 prefix=$3
case $dir in "~") dir=$HOME ;; "~/"*) dir=$HOME/${dir#"~/"} ;; esac
command -v shpool >/dev/null || { echo "shpool is not on PATH on $(uname -n)" >&2; exit 1; }
[ -d "$dir" ] || { echo "no directory $dir" >&2; exit 1; }
cd "$dir"
echo "dir: $PWD"
if [ -z "$agent" ]; then
  echo "reason: no default agent is chosen (omarchy default agent <name>)"
elif ! command -v "$agent" >/dev/null; then
  echo "reason: $agent is not installed on $(uname -n)"
  agent=
fi
echo "agent: $agent"
if [ "$agent" = claude ] &&
  ! grep -qs '"questmarchy@questmarchy"' "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/plugins/installed_plugins.json"; then
  echo "unlinked: Questmarchy's plugin for Claude Code is not installed on $(uname -n)"
fi
for link in "$HOME/.local/state/questmarchy/sessions/shpool/$prefix"*.json; do
  [ -f "$link" ] || continue
  link=${link##*/}
  echo "link: ${link%.json}"
done
echo "sessions:"
shpool list --json
EOF
}

# From shpool list --json and the linked sessions, as positional arguments,
# choose the sessions named <prefix><number> to open a window for: each
# disconnected one, so that a closed window's agent is picked up again, and
# each linked one that shpool lost, so that its conversation is resumed; or,
# when there is neither, a new one with the lowest number free of both. Print
# "<number> existing", "<number> lost", or "<number> new" for each.
choose_sessions_jq='
  def number: ltrimstr($prefix) | select(test("^[1-9][0-9]*$")) | tonumber;
  [.sessions[] | select(.name | startswith($prefix))
    | {number: (.name | number), status: (.status | ascii_downcase)}] as $listed
  | [$ARGS.positional[] | select(startswith($prefix)) | number] as $linked
  | ($listed | map(.number)) as $numbers
  | [($listed[] | select(.status == "disconnected") | "\(.number) existing"),
     (($linked - $numbers | unique)[] | "\(.) lost")]
  | if length > 0 then .[]
    else "\([range(1; ($numbers + $linked | unique | length) + 2)] - $numbers - $linked | min) new" end
'

list=
while getopts nlw:h opt; do
  case $opt in
    n) dry_run=1 ;;
    l) list=1 ;;
    w) world=$OPTARG ;;
    h) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done
shift $((OPTIND - 1))

find_quest

if [[ -n $list ]]; then
  (( $# == 0 )) || { usage >&2; exit 2; }
  # The caller reports the worlds that failed: the bar widget shows them in
  # its panel.
  list_all
  exit
fi

if (( $# < 1 || $# > 2 )); then
  usage >&2
  exit 2
fi

project=$1
slug=${2:-}

[[ $project =~ ^[A-Za-z0-9._-]+$ ]] || fail "not a project name: $project"
[[ -z $slug || $slug =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || fail "not a quest slug: $slug"

# Print the project or quest as quest realm show or quest show does. With no
# world, it is looked for in every world.
find_entry() {
  local errors output status=0
  errors=$(mktemp)
  if [[ -n $slug ]]; then
    output=$("${quest[@]}" show ${world:+--world="$world"} -- "$project" "$slug" 2>"$errors") || status=$?
  else
    output=$("${quest[@]}" realm show ${world:+--world="$world"} -- "$project" 2>"$errors") || status=$?
  fi
  local message=$(<"$errors")
  rm -f "$errors"
  (( status == 0 )) || fail "${message:-quest exited with status $status}"
  printf '%s\n' "$output"
}

entry=
if [[ -z $world ]]; then
  entry=$(find_entry)
  world=$(jq -r .world <<<"$entry")
fi
parse_world "$world" || fail "not a world: $world"

machine=${host:-$(uname -n)}
prefix=questmarchy:$project${slug:+:$slug}
# Omarchy tags TUI.* windows as terminals, so Super+V pastes in them. Without
# the tag it sends Ctrl+V, which an agent such as Claude Code takes as an image
# paste, dropping text.
class=TUI.questmarchy.$machine.$project${slug:+.$slug}
# A new session starts Omarchy's default agent on this computer, as its own
# command wherever the project lives.
agent=$(omarchy-default-agent 2>/dev/null || true)
[[ $agent =~ ^[a-z][a-z0-9-]*$ ]] || agent=
here=$(dirname "$(realpath "${BASH_SOURCE[0]}")")

address=$(hyprctl clients -j | jq -r --arg class "$class" '.[] | select(.class == $class) | .address' | head -n1)

# Run in a window: attach to a session that choose_sessions_jq chose. The
# launcher runs it with xdg-terminal-exec -e, which still reads options such as
# -h in the command, so quest-session takes none.
window_command() {
  command=(omarchy-launch-tui --app-id="$class" bash "$here/quest-session" "${host:-localhost}" "$1" "$2" ${3:+"$3"})
}

if [[ -n $address ]]; then
  command=(hyprctl dispatch "hl.dsp.focus({ window = \"address:$address\" })")
  if [[ -n $dry_run ]]; then
    echo "would run: ${command[*]}"
  else
    "${command[@]}" >/dev/null
    record_opened || true
  fi
  exit
fi

# Only a session that is created needs the directory, which the quest command
# finds in the realm's quests directory.
[[ -n $entry ]] || entry=$(find_entry)
dir=$(jq -r .dir <<<"$entry")

if [[ -n $dry_run ]]; then
  echo "would attach every disconnected $prefix:<number> on $machine and recreate every linked one shpool lost, or else create one in $dir with ${agent:-no agent}"
  window_command "$prefix:<number>" "$dir" "$agent"
  echo "would run for each: ${command[*]}"
else
  output=$(prepare_session "$host" "$dir" "$agent" "$prefix:" 2>&1) ||
    fail "could not open a session for $prefix on $machine: $output"
  field() { sed -n "s/^$1: //p" <<<"$output"; }
  mapfile -t links < <(field link)
  chosen=$(sed '1,/^sessions:$/d' <<<"$output" |
    jq -r --arg prefix "$prefix:" "$choose_sessions_jq" --args "${links[@]}" 2>/dev/null) ||
    fail "could not read the sessions on $machine: $output"
  # A running session ignores the agent and keeps its own. A session whose agent
  # exited while no window was attached is still listed, and starts it again. A
  # lost session is recreated with the agent its link names.
  if [[ $chosen == *new ]]; then
    reason=$(field reason) unlinked=$(field unlinked)
    [[ -z $reason ]] || notice "the session starts a shell, because $reason"
    [[ -z $unlinked ]] || notice "the session's conversation will not come back if shpool loses the session, because $unlinked"
  fi
  record_opened || true
  mapfile -t chosen <<<"$chosen"
  for choice in "${chosen[@]}"; do
    window_command "$prefix:${choice% *}" "$(field dir)" "$(field agent)"
    "${command[@]}" || notice "could not open a window for $prefix:${choice% *}"
  done
fi
