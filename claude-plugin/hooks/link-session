#!/bin/sh
# link-session: keep the link between the Questmarchy session an agent runs in
# and the agent's conversation, so that sessionctl can resume the conversation
# when the mux has lost the session, as after a reboot. Claude's hooks run it:
# `save` whenever a conversation starts, with the hook's input on standard
# input, and `drop` when the user quits.
#
# sessionctl sets QUESTMARCHY_SESSION in the agent's command to
# <mux>/<session>, which names the link. Without it the agent is not running in
# a Questmarchy session, and nothing is done.
set -u

session=${QUESTMARCHY_SESSION:-}
case $session in
  .* | */.* | */*/*) exit 0 ;;
  ?*/?*) ;;
  *) exit 0 ;;
esac

# Not under XDG_STATE_HOME, which the shell that sessionctl reads the links
# from may not set.
dir=$HOME/.local/state/questmarchy/sessions/${session%%/*}
link=$dir/${session#*/}.json

case ${1:-} in
  save)
    # The link holds the hook's input as Claude gave it. It is written in
    # place: sessionctl reads it only to recreate a session that shpool lost,
    # when nothing is writing it, and a running session ignores the command
    # made from it. A link cut short, as by a crash, names no conversation, and
    # the session starts the agent instead. A Claude that started before the
    # plugin's update may still pass `save claude`; the name is ignored.
    mkdir -p "$dir" && cat >"$link"
    ;;
  drop)
    rm -f "$link"
    ;;
  *)
    echo "usage: link-session save | drop" >&2
    exit 1
    ;;
esac
